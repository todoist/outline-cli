{
    // Agent tooling runs straight from source with Node's type stripping, so it may only use
    // erasable TypeScript syntax and must import files with their .ts extension. The root
    // tsconfig.json covers only src/, without its tests, so this is what type-checks the tooling
    // and its tests. The Pi extension in .pi/ is agent tooling too, and its test loads it the same
    // way. Its include needs the glob: a bare folder name outside this one matches no files.
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "rootDir": "../..",
        "noEmit": true,
        "declaration": false,
        "sourceMap": false,
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true,
        "lib": ["es2023"],
        "types": ["node"]
    },
    "include": [".", "../../.pi/**/*"]
}
