{
	"name": "@todoist/outline-cli",
	"version": "3.1.7",
	"description": "CLI for the Outline wiki/knowledge base API",
	"type": "module",
	"bin": {
		"ol": "./dist/index.js"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/todoist/outline-cli.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"homepage": "https://github.com/todoist/outline-cli#readme",
	"bugs": {
		"url": "https://github.com/todoist/outline-cli/issues"
	},
	"files": [
		"dist",
		"scripts",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"type-check": "tsc --noEmit && tsc --noEmit -p .agents/scripts",
		"lint:check": "oxlint src .agents/scripts",
		"lint:write": "oxlint src .agents/scripts --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"test:watch": "vitest",
		"verify": "node .agents/scripts/verify.ts",
		"review:worktree": "node .agents/scripts/review-worktree.ts",
		"postinstall": "node scripts/postinstall.js",
		"check:skill-sync": "node scripts/check-skill-sync.js",
		"sync:skill": "npm run build && node scripts/sync-skill.js",
		"prepublishOnly": "npm run build && npm test",
		"prepare": "lefthook install --reset-hooks-path"
	},
	"keywords": [
		"outline",
		"wiki",
		"cli"
	],
	"license": "MIT",
	"engines": {
		"node": ">=24",
		"npm": ">=11"
	},
	"dependencies": {
		"@todoist/cli-core": "2.0.3",
		"chalk": "6.0.1",
		"commander": "15.1.0",
		"marked": "18.2.1",
		"marked-terminal-renderer": "2.2.0",
		"oauth4webapi": "3.8.9",
		"open": "11.0.4",
		"undici": "7.30.2"
	},
	"devDependencies": {
		"@semantic-release/changelog": "7.0.0",
		"@semantic-release/git": "11.0.1",
		"@types/node": "26.6.6",
		"conventional-changelog-conventionalcommits": "9.3.1",
		"lefthook": "2.2.2",
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"semantic-release": "25.0.9",
		"typescript": "7.0.2",
		"vitest": "5.1.1"
	}
}
